# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file to git.

# Get this connection string from MongoDB Atlas:
# Atlas dashboard -> Database -> Connect -> "Drivers" -> copy the string
# Replace <password> with your real database user password
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/onerxiv_tutorial

PORT=4000
